# --- Monorepo root ignores ---
# (mobile/ and dashboard/ each keep their own .gitignore for app-specific paths)

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/

# Logs
*.log

# Orphaned Flutter artifacts left at the repo root by the pre-monorepo layout —
# the live ones now live under mobile/. Safe to delete from disk.
/build/
/.dart_tool/
/.flutter-plugins-dependencies
/.flutter-plugins

# Node / Next.js (dashboard/ also has its own generated .gitignore)
node_modules/
.next/
out/
dist/
.vercel/
*.tsbuildinfo
.env*.local
