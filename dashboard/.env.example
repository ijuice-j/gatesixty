# Copy to .env.local and fill in.

# Supabase — safe to expose to the browser (NEXT_PUBLIC_*); Row-Level Security
# is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Google OAuth — SERVER-ONLY (no NEXT_PUBLIC_ prefix; never expose the secret).
# Same OAuth client configured for Supabase's Google provider. Used server-side
# to exchange the stored refresh token for Calendar API access tokens.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
